<Window x:Class="ZenithOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenith" Height="760" Width="1120"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Apple Monochrome Palette (Light Mode Default - White First) -->
        <SolidColorBrush x:Key="BgBase" Color="#FBFBFD" />
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgCardHover" Color="#F5F5F7" />
        <SolidColorBrush x:Key="BgSidebar" Color="#F5F5F7" />
        <SolidColorBrush x:Key="BgSunken" Color="#F0F0F2" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#E5E5EA" />
        <SolidColorBrush x:Key="BorderCard" Color="#E5E5EA" />
        <SolidColorBrush x:Key="BorderStrong" Color="#D1D1D6" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="TextMuted" Color="#86868B" />
        <SolidColorBrush x:Key="AccentAction" Color="#1D1D1F" />
        <SolidColorBrush x:Key="AccentActionFg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentActionHover" Color="#38383A" />
        <SolidColorBrush x:Key="ActiveStateBg" Color="#E5E5EA" />
        <SolidColorBrush x:Key="ActiveStateBorder" Color="#D1D1D6" />
        <SolidColorBrush x:Key="ActiveStateText" Color="#1D1D1F" />

        <!-- Apple Minimalist Fluid Sliding Toggle Switch -->
        <Style x:Key="ModernToggle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="38" Height="20">
                                    <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource BorderSubtle}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                                    <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.18" />
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTransform" X="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentAction}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentAction}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluid Primary Action Button (Apple Spring Physics) -->
        <Style x:Key="AccentBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentAction}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentActionFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentActionHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fluid Secondary Button (Apple Clean Border) -->
        <Style x:Key="SecondaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardHover}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluid Apple-Style Sidebar Nav Pill -->
        <Style x:Key="NavBtn" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ActiveStateBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentAction}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentActionFg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Apple ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Foreground" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="{DynamicResource BorderStrong}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Asymmetrical Root Layout: Apple Command Rail (250px) + Clean Showcase Canvas (*) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT ASYMMETRICAL COMMAND RAIL -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="16,20">
            <DockPanel>
                <!-- Bottom Engine Compliance Pill -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Anti-Cheat Certified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Native Windows OS APIs • Zero DLL Hooks" FontSize="9" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Top Rail Content -->
                <StackPanel DockPanel.Dock="Top">
                    <!-- Apple Monochrome Brand & Theme -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Background="{DynamicResource AccentAction}" CornerRadius="7" Margin="0,0,10,0">
                                <TextBlock Text="Z" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentActionFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ZENITH" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="System Optimizer" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnThemeToggle" Grid.Column="1" Content="Theme: Light" Style="{StaticResource SecondaryBtn}" Padding="8,4" FontSize="10" FontWeight="SemiBold" Click="BtnThemeToggle_Click" ToolTip="Switch between Light and Dark mode" />
                    </Grid>

                    <!-- Engine State Module -->
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ENGINE STATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock x:Name="StatusText" Text="System Guard Active" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,8" />
                            <CheckBox x:Name="ChkAutoOptimize" Content="Auto-Boost On Launch" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Apple Streamlined Navigation -->
                    <TextBlock Text="NAVIGATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6" />
                    <RadioButton x:Name="NavGames" Content="Games (9 Titles)" Style="{StaticResource NavBtn}" IsChecked="True" Checked="Nav_Checked" Tag="Games" />
                    <RadioButton x:Name="NavLatency" Content="Speed &amp; Latency" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Latency" />
                    <RadioButton x:Name="NavMemory" Content="RAM &amp; Power" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Memory" />
                    <RadioButton x:Name="NavNetwork" Content="Network &amp; Ping" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Network" />
                    <RadioButton x:Name="NavBlueStacks" Content="BlueStacks (MLBB)" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="BlueStacks" />
                    <RadioButton x:Name="NavLogs" Content="Activity Terminal" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Logs" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT CONTENT CANVAS -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Top Utility Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusBadgeBorder" Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="8,3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource AccentAction}" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.3" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.3" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.5" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BadgeLatencySaved" Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="8,3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtLatencySaved" Text="0.500 ms Latency Target" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Export" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Padding="10,4" FontSize="11" Click="BtnExportProfile_Click" ToolTip="Export profile backup." />
                        <Button Content="Import" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Padding="10,4" FontSize="11" Click="BtnImportProfile_Click" ToolTip="Import profile backup." />
                        <Button Content="Restore Defaults" Style="{StaticResource DangerBtn}" Padding="10,4" FontSize="11" Click="BtnRestoreDefaults_Click" ToolTip="Restore Windows system defaults." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Showcase Area -->
            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel" Padding="28,24">
                <Grid>
                    <!-- 1. GAMES VIEW (PRIMARY APPLE PRODUCT SHOWCASE) -->
                    <StackPanel x:Name="ViewGames" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <!-- Apple Hero Stage Card -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="12" Padding="32,26" Margin="0,0,0,22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Apple Spec Tags -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Text="PRO ARCHITECTURE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="MICROSECOND PRECISION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                </StackPanel>

                                <!-- Hero Typography -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock x:Name="DashHeroTitle" Text="Ready &amp; Monitoring" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="DashHeroDesc" Text="Automatic 0.500ms kernel timer, audio shield, and high process priority." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Apple Spec Badges Row -->
                                <WrapPanel Grid.Row="2" Margin="0,0,0,20">
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tick Rate: " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock x:Name="TxtTimerRes" Text="0.500 ms" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CPU: " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock x:Name="TxtCpuLoad" Text="-- %" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="RAM: " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock x:Name="TxtRamLoad" Text="-- %" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Power: " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock x:Name="TxtPowerPlan" Text="High Performance" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Hero Action Buttons (Apple Pill) -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button x:Name="BtnManualBoost" Content="Boost System Now" Style="{StaticResource AccentBtn}" Padding="20,9" FontSize="12" Click="BtnManualBoost_Click" Margin="0,0,8,0" />
                                    <Button Content="Trim Working RAM" Style="{StaticResource SecondaryBtn}" Padding="16,9" FontSize="12" Click="BtnPurgeRam_Click" Margin="0,0,8,0" />
                                    <Button Content="Scan Running Windows" Style="{StaticResource SecondaryBtn}" Padding="16,9" FontSize="12" Click="BtnDetectGames_Click" Margin="0,0,8,0" />
                                    <Button Content="Add Executable" Style="{StaticResource SecondaryBtn}" Padding="16,9" FontSize="12" Click="BtnAddCustomGame_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Discovered Running Apps Section -->
                        <Border x:Name="PnlDiscoveredApps" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="RUNNING WINDOWS DETECTED" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <Button Content="Close" Style="{StaticResource SecondaryBtn}" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Click="BtnCloseDiscovered_Click" />
                                </Grid>
                                <StackPanel x:Name="PnlDiscoveredList" />
                            </StackPanel>
                        </Border>

                        <!-- Curated Titles Library Header -->
                        <TextBlock Text="CURATED TITLES (9)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />

                        <!-- Dynamic Game Cards Stack -->
                        <StackPanel x:Name="PnlGameProfilesList" />
                    </StackPanel>

                    <!-- 2. SPEED & LATENCY VIEW -->
                    <StackPanel x:Name="ViewLatency" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Speed &amp; Latency Engine" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Kernel timer resolution, priority scheduling, and core allocation." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="High-Precision Kernel Timer (0.500 ms)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakTimer" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="AudioDG Thread Priority Shield" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkAudioStabilization" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Top Process Scheduling Priority" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakPriority" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="DirectX GPU Queue Priority (MMCSS)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkGpuPriority" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Throttle Non-Gaming Background Tasks" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakThrottle" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Suppress Windows GameDVR Background Capture" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkDisableGameDvr" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="P-Core Affinity Pinning (Desktop Only)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakPCores" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Hardware Diagnostics Strip -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="HOST PLATFORM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtDetectedCpu" Text="Intel Processor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtDetectedGpu" Text="Graphics Adapter" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cores: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtCpuCores" Text="12 Cores • Ready" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" />
                                    <TextBlock Text="Game Mode: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtGameModeState" Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" />
                                    <TextBlock Text="DVR: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtGameDvrState" Text="Disabled" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. MEMORY & POWER VIEW -->
                    <StackPanel x:Name="ViewMemory" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Memory &amp; Power Architecture" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Standby cache management, working set trimming, and power schemes." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Auto-Purge Standby Memory on Game Launch" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkAutoPurge" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Automatic High Performance Power Switching" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkPowerPlan" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Manual Working Set &amp; Standby Trim" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtRamDetails" Text="-- / -- GB" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,2" />
                                    <TextBlock x:Name="TxtPurgeStatus" Text="Ready." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                                <Button Content="Trim Memory Now" Style="{StaticResource AccentBtn}" Grid.Column="1" VerticalAlignment="Center" Click="BtnPurgeRam_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 4. NETWORK & PING VIEW -->
                    <StackPanel x:Name="ViewNetwork" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Network &amp; Latency Configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="TCP packet dispatch and connection jitter benchmark." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Multi-Sample Latency Benchmark" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbPingTarget" SelectedIndex="0" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderCard}">
                                        <ComboBoxItem Content="Cloudflare Anycast DNS (1.1.1.1)" Tag="1.1.1.1" />
                                        <ComboBoxItem Content="Google Primary DNS (8.8.8.8)" Tag="8.8.8.8" />
                                        <ComboBoxItem Content="Riot Games Asia Gateway (104.160.156.1)" Tag="104.160.156.1" />
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Run Benchmark" Style="{StaticResource AccentBtn}" Margin="8,0,0,0" Click="BtnBenchmarkPing_Click" />
                                </Grid>
                                <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <TextBlock x:Name="TxtPingResult" Text="Ready to run benchmark." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Low-Latency Packet Dispatch (TCPNoDelay)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtNetworkStatus" Text="Status: Ready." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnApplyNetwork" Content="Apply TCPNoDelay" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="BtnApplyNetwork_Click" />
                                    <Button Content="Restore Defaults" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreNetwork_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 5. BLUESTACKS (MLBB) VIEW -->
                    <StackPanel x:Name="ViewBlueStacks" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="BlueStacks &amp; Mobile Legends" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Virtual machine hypervisor tuning and tournament display locks." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Container Status" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtBsConfigStatus" Text="Scanning configuration..." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Optimize Container" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="BtnOptimizeBlueStacks_Click" />
                                    <Button Content="Restore Backup" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreBlueStacks_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Safety Invariants" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock Text="• Key B MOBA Skillpad Protected: com.mobile.legends.cfg preserved" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                <TextBlock Text="• 16:9 Full HD (1920x1080) Locked: Ultra-wide stripped to prevent distortion" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                <TextBlock Text="• ASUS ROG Phone 7 Ultimate Profile: 120 FPS Whitelist active" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. ACTIVITY LOG VIEW -->
                    <StackPanel x:Name="ViewLogs" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <Grid Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Engine Activity Terminal" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Chronological log of optimization events." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Clear Log" HorizontalAlignment="Right" Style="{StaticResource SecondaryBtn}" Click="BtnClearLog_Click" Padding="10,3" FontSize="11" />
                        </Grid>

                        <Border Background="{DynamicResource BgSunken}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <TextBox x:Name="TxtEventLog" Height="420" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontFamily="Consolas, monospace" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Floating Toast Notification -->
            <Border x:Name="ToastNotification" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Text="Action Executed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </Border>

            <!-- Bottom Status Strip -->
            <Border Grid.Row="2" Background="{DynamicResource BgSunken}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtFooterStatus" Text="Zenith Engine Ready. 0 games running. Input Response: 0.500 ms" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="100% Anti-Cheat Safe • Native Windows APIs" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
