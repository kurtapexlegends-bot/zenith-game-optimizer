<Window x:Class="ZenithOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenith Game Optimizer" Height="680" Width="1060"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="pack://application:,,,/ZenithOptimizer;component/app.ico"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TextPrimary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Frosted Glass Palette (Light Mode Default - Clean White First) -->
        <SolidColorBrush x:Key="BgBase" Color="#FAF8FAFC" />
        <SolidColorBrush x:Key="BgCard" Color="#D2FFFFFF" />
        <SolidColorBrush x:Key="BgCardHover" Color="#F0FFFFFF" />
        <SolidColorBrush x:Key="BgSidebar" Color="#F5F1F5F9" />
        <SolidColorBrush x:Key="BgSunken" Color="#78E2E8F0" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#10000000" />
        <SolidColorBrush x:Key="BorderCard" Color="#18000000" />
        <SolidColorBrush x:Key="BorderStrong" Color="#30000000" />
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#475569" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentAction" Color="#0F172A" />
        <SolidColorBrush x:Key="AccentActionFg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentActionHover" Color="#1E293B" />
        <SolidColorBrush x:Key="ActiveStateBg" Color="#B4E2E8F0" />
        <SolidColorBrush x:Key="ActiveStateBorder" Color="#32000000" />
        <SolidColorBrush x:Key="ActiveStateText" Color="#0F172A" />
        <SolidColorBrush x:Key="ToggleActiveGreen" Color="#10B981" />

        <!-- Minimalist Fluid Sliding Toggle Switch -->
        <Style x:Key="ModernToggle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="38" Height="20">
                                    <Border x:Name="TrackOff" CornerRadius="10" Background="{DynamicResource BorderSubtle}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                                    <Border x:Name="TrackOn" CornerRadius="10" Background="{StaticResource ToggleActiveGreen}" BorderBrush="{StaticResource ToggleActiveGreen}" BorderThickness="1" Opacity="0" />
                                    <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.18" />
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ThumbTransform" X="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackOff" Property="Opacity" Value="0.4" />
                                <Setter TargetName="TrackOn" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluid Primary Action Button -->
        <Style x:Key="AccentBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentAction}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentActionFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentActionHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fluid Secondary Button -->
        <Style x:Key="SecondaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BgCardHover}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderCard}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Buttons (Windows 11 Fluent Dimensions & Hit-Testing) -->
        <Style x:Key="CaptionBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BgSunken}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E11D48" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#BE123C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Sidebar Navigation Pill -->
        <Style x:Key="NavBtn" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ActiveStateBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentAction}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentActionFg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Minimalist ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Foreground" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="{DynamicResource BorderStrong}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern Minimalist ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Border" CornerRadius="8" 
                                                Background="{DynamicResource BgCard}" 
                                                BorderBrush="{DynamicResource BorderCard}" 
                                                BorderThickness="1" Padding="12,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Margin="8,0,0,0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0" 
                                                      Stroke="{DynamicResource TextSecondary}" 
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgCardHover}" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,0,28,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" CornerRadius="8" 
                                            Background="{DynamicResource BgCard}" 
                                            BorderBrush="{DynamicResource BorderStrong}" 
                                            BorderThickness="1" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.12" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" 
                                Background="Transparent" CornerRadius="6" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ActiveStateBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentAction}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentActionFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Modern Minimalist Root Layout: Left Command Rail (230px) + Right Content Canvas (*) -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COMMAND RAIL -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="16,18,16,16">
            <DockPanel>
                <!-- Bottom Compliance Pill -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Anti-Cheat Certified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Native Win32 APIs • Zero Injections" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Top Rail Content -->
                <StackPanel DockPanel.Dock="Top">
                    <!-- Brand Header & Theme Toggle -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" Background="{DynamicResource AccentAction}" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="Z" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentActionFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ZENITH" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="PERFORMANCE ENGINE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnThemeToggle" Grid.Column="1" Style="{StaticResource SecondaryBtn}" Width="32" Height="30" Padding="0" Click="BtnThemeToggle_Click" ToolTip="Switch between Light and Dark mode" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Sun Icon (Visible in Light Mode) -->
                                <Path x:Name="IconSun" Data="M 7,0 L 7,2 M 7,12 L 7,14 M 0,7 L 2,7 M 12,7 L 14,7 M 2.05,2.05 L 3.46,3.46 M 10.54,10.54 L 11.95,11.95 M 2.05,11.95 L 3.46,10.54 M 10.54,3.46 L 11.95,2.05 M 7,3.5 A 3.5,3.5 0 1,0 7,10.5 A 3.5,3.5 0 1,0 7,3.5" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Visible" />
                                <!-- Moon Icon (Visible in Dark Mode) -->
                                <Path x:Name="IconMoon" Data="M 12.5,8 A 5.5,5.5 0 1,1 6,1.5 A 6.5,6.5 0 0,0 12.5,8 Z" Fill="{DynamicResource TextPrimary}" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Engine State Indicator Module -->
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ENGINE PULSE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock x:Name="StatusText" Text="System Guard Active" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,8" />
                            <CheckBox x:Name="ChkAutoOptimize" Content="Auto-Boost On Launch" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Sleek Navigation Menu -->
                    <TextBlock Text="NAVIGATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6" />
                    <RadioButton x:Name="NavGames" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" IsChecked="True" Checked="Nav_Checked" Tag="Games">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 2,5 C 2,3.3 3.3,2 5,2 L 9,2 C 10.7,2 12,3.3 12,5 L 12,8.5 C 12,10.2 10.7,11.5 9,11.5 L 8.2,10.5 L 5.8,10.5 L 5,11.5 C 3.3,11.5 2,10.2 2,8.5 Z M 4,6.8 L 6.5,6.8 M 5.25,5.5 L 5.25,8" />
                            <TextBlock Text="Games (9 Titles)" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLatency" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Latency">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 1,9 A 6,6 0 1,1 13,9 M 7,7 L 10.5,4.5" />
                            <TextBlock Text="Speed &amp; Latency" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMemory" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Memory">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 3,3 L 11,3 L 11,11 L 3,11 Z M 1,5 L 3,5 M 1,9 L 3,9 M 11,5 L 13,5 M 11,9 L 13,9 M 5,1 L 5,3 M 9,1 L 9,3 M 5,11 L 5,13 M 9,11 L 9,13" />
                            <TextBlock Text="RAM &amp; Power" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNetwork" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Network">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 1,4.5 A 8,8 0 0,1 13,4.5 M 3,7 A 5.5,5.5 0 0,1 11,7 M 5.5,9.5 A 2.5,2.5 0 0,1 8.5,9.5 M 7,12 A 0.5,0.5 0 1,1 7,12.1" />
                            <TextBlock Text="Network &amp; Ping" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBlueStacks" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="BlueStacks">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 7,1.5 L 13,4.5 L 7,7.5 L 1,4.5 Z M 1,8 L 7,11 L 13,8 M 1,11 L 7,14 L 13,11" />
                            <TextBlock Text="BlueStacks &amp; MLBB" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLogs" GroupName="SidebarNavigation" Style="{StaticResource NavBtn}" Checked="Nav_Checked" Tag="Logs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" Data="M 1,2 L 13,2 L 13,12 L 1,12 Z M 3,5 L 6,7 L 3,9 M 7,9 L 11,9" />
                            <TextBlock Text="Activity Terminal" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT SHOWCASE CANVAS -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top Utility Bar & Custom Caption Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,0,0,0">
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border x:Name="StatusBadgeBorder" Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="8,4" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource AccentAction}" Margin="0,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1.3" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1.3" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0.6" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock x:Name="TxtStatusBadge" Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="BadgeLatencySaved" Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="8,4" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtLatencySaved" Text="0.500 ms Latency Target" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Drag Zone -->
                    <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                    <!-- Top Bar Right Controls & Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="Export" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Padding="10,4" FontSize="11" Click="BtnExportProfile_Click" ToolTip="Export profile backup." VerticalAlignment="Center" />
                        <Button Content="Import" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Padding="10,4" FontSize="11" Click="BtnImportProfile_Click" ToolTip="Import profile backup." VerticalAlignment="Center" />
                        <Button Content="Restore Defaults" Style="{StaticResource DangerBtn}" Margin="0,0,10,0" Padding="10,4" FontSize="11" Click="BtnRestoreDefaults_Click" ToolTip="Restore Windows system defaults." VerticalAlignment="Center" />

                        <!-- Window Caption Controls: Minimize, Maximize / Restore, Close -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="BtnWinMinimize" Style="{StaticResource CaptionBtn}" Click="BtnWinMinimize_Click" ToolTip="Minimize to Tray">
                                <Path Data="M 0,5 L 10,5" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="BtnWinMaximize" Style="{StaticResource CaptionBtn}" Click="BtnWinMaximize_Click" ToolTip="Maximize / Fullscreen">
                                <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IconMaximize" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Visibility="Visible" />
                                    <Path x:Name="IconRestore" Data="M 2,0 L 10,0 L 10,8 L 8,8 L 8,10 L 0,10 L 0,2 L 2,2 Z M 1,3 L 7,3 L 7,9 L 1,9 Z M 3,2 L 3,1 L 9,1 L 9,7 L 8,7 L 8,2 Z" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button x:Name="BtnWinClose" Style="{StaticResource CaptionCloseBtn}" Click="BtnWinClose_Click" ToolTip="Close (Runs in Tray)">
                                <Path x:Name="IconClose" Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Scrollable Content Area -->
            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel" Padding="22,18">
                <Grid>
                    <!-- 1. GAMES VIEW (PRIMARY SHOWCASE) -->
                    <StackPanel x:Name="ViewGames" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <!-- Sleek Telemetry & Action HUD -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Status Title & Live Telemetry Pills -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Title & Desc -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashHeroTitle" Text="Ready &amp; Monitoring" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="DashHeroDesc" Text="Automatic 0.500ms kernel timer, audio shield, and high process priority." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Live Telemetry Badges -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Timer: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtTimerRes" Text="0.500 ms" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="CPU: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtCpuLoad" Text="-- %" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="RAM: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtRamLoad" Text="-- %" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Thermals: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtThermalState" Text="Standard" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="8,4" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Power: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtPowerPlan" Text="High Performance" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Quick Action Pill Deck -->
                                <WrapPanel Grid.Row="1">
                                    <Button x:Name="BtnManualBoost" Content="Boost System Now" Style="{StaticResource AccentBtn}" Padding="16,7" FontSize="11" Click="BtnManualBoost_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnCooldownNow" Content="Cool Down Laptop" Style="{StaticResource SecondaryBtn}" Padding="14,7" FontSize="11" Click="BtnInstantCooldown_Click" Margin="0,0,8,0" />
                                    <Button Content="Trim Working RAM" Style="{StaticResource SecondaryBtn}" Padding="14,7" FontSize="11" Click="BtnPurgeRam_Click" Margin="0,0,8,0" />
                                    <Button Content="Scan Running Windows" Style="{StaticResource SecondaryBtn}" Padding="14,7" FontSize="11" Click="BtnDetectGames_Click" Margin="0,0,8,0" />
                                    <Button Content="Add Executable" Style="{StaticResource SecondaryBtn}" Padding="14,7" FontSize="11" Click="BtnAddCustomGame_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Discovered Running Apps Section -->
                        <Border x:Name="PnlDiscoveredApps" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="RUNNING WINDOWS DETECTED" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <Button Content="Close" Style="{StaticResource SecondaryBtn}" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Click="BtnCloseDiscovered_Click" />
                                </Grid>
                                <StackPanel x:Name="PnlDiscoveredList" />
                            </StackPanel>
                        </Border>

                        <!-- Games Library Header & Organization Toolbar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Title & Count -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="TxtGamesLibraryHeader" Text="GAMES LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource BgSunken}" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <TextBlock x:Name="TxtGamesCountBadge" Text="9 Titles" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </StackPanel>

                            <!-- Instant Search & Filter Input Box -->
                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource BgCard}" CornerRadius="8" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Width="200" Height="28" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Margin="8,0,5,0" VerticalAlignment="Center" Width="10" Height="10" Data="M 4,1 A 3,3 0 1,1 4,7 A 3,3 0 1,1 4,1 Z M 6.5,6.5 L 9.5,9.5" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2" />
                                    <TextBox x:Name="TxtSearchGames" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="11" VerticalAlignment="Center" Padding="0,0,2,0" TextChanged="TxtSearchGames_TextChanged" />
                                    <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Search games, tags, exe..." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
                                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Style="{StaticResource CaptionBtn}" Width="20" Height="20" FontSize="9" Padding="0" Margin="0,0,2,0" Visibility="Collapsed" Click="BtnClearSearch_Click" ToolTip="Clear search filter" />
                                </Grid>
                            </Border>

                            <!-- Organization Controls: Sort Selector & View Switcher -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="CmbSortGames" Width="130" Height="28" Margin="0,0,10,0" SelectionChanged="CmbSortGames_SelectionChanged">
                                    <ComboBoxItem Content="Custom / Drag" IsSelected="True" Tag="Custom" />
                                    <ComboBoxItem Content="Name (A-Z)" Tag="Name" />
                                    <ComboBoxItem Content="Favorites First" Tag="Favorites" />
                                    <ComboBoxItem Content="Active First" Tag="Active" />
                                </ComboBox>

                                <!-- View Mode Switcher: Cards vs List -->
                                <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnViewCards" Content="Cards" Style="{StaticResource SecondaryBtn}" Padding="8,3" FontSize="10" Click="BtnViewCards_Click" ToolTip="Rich Cards View" />
                                        <Button x:Name="BtnViewList" Content="Deck" Style="{StaticResource SecondaryBtn}" Padding="8,3" FontSize="10" Click="BtnViewList_Click" ToolTip="Compact Metrics Matrix &amp; Quick-Action Deck" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Dynamic Game Cards Stack -->
                        <StackPanel x:Name="PnlGameProfilesList" />
                    </StackPanel>

                    <!-- 2. SPEED & LATENCY VIEW -->
                    <StackPanel x:Name="ViewLatency" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Speed &amp; Latency Engine" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Kernel timer resolution, priority scheduling, and core allocation." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="High-Precision Kernel Timer (0.500 ms)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakTimer" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="AudioDG Thread Priority Shield" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkAudioStabilization" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Top Process Scheduling Priority" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakPriority" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="DirectX GPU Queue Priority (MMCSS)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkGpuPriority" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Throttle Non-Gaming Background Tasks" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakThrottle" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Suppress Windows GameDVR Background Capture" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkDisableGameDvr" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="P-Core Affinity Pinning (Avoids E-Cores)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkTweakPCores" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Hardware Diagnostics Strip -->
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="HOST PLATFORM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="TxtDetectedCpu" Text="Intel Processor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,1" />
                                <TextBlock x:Name="TxtDetectedGpu" Text="Graphics Adapter" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cores: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtCpuCores" Text="12 Cores - Ready" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" />
                                    <TextBlock Text="Game Mode: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtGameModeState" Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" />
                                    <TextBlock Text="DVR: " FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock x:Name="TxtGameDvrState" Text="Disabled" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. MEMORY & POWER VIEW -->
                    <StackPanel x:Name="ViewMemory" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Memory &amp; Power Architecture" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Standby cache management, working set trimming, and power schemes." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Auto-Purge Standby Memory on Game Launch" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkAutoPurge" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Automatic High Performance Power Switching" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkPowerPlan" HorizontalAlignment="Right" Style="{StaticResource ModernToggle}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Laptop Thermal Guard &amp; Active Fan Cooler" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Engages active ACPI fan cooling policy and caps CPU at 99% frequency to stop thermal throttling." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCooldownView" Content="Rapid Cooldown" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11" Click="BtnInstantCooldown_Click" Margin="0,0,12,0" />
                                    <CheckBox x:Name="ChkLaptopCooler" Style="{StaticResource ModernToggle}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Manual Working Set &amp; Standby Trim" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtRamDetails" Text="-- / -- GB" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,2" />
                                    <TextBlock x:Name="TxtPurgeStatus" Text="Ready." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                                <Button Content="Trim Memory Now" Style="{StaticResource AccentBtn}" Grid.Column="1" VerticalAlignment="Center" Click="BtnPurgeRam_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 4. NETWORK & PING VIEW -->
                    <StackPanel x:Name="ViewNetwork" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="Network &amp; Latency Configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="TCP packet dispatch and connection jitter benchmark." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Multi-Sample Latency Benchmark" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbPingTarget" SelectedIndex="0" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderCard}">
                                        <ComboBoxItem Content="Cloudflare Anycast DNS (1.1.1.1)" Tag="1.1.1.1" />
                                        <ComboBoxItem Content="Google Primary DNS (8.8.8.8)" Tag="8.8.8.8" />
                                        <ComboBoxItem Content="Riot Games Asia Gateway (104.160.156.1)" Tag="104.160.156.1" />
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Run Benchmark" Style="{StaticResource AccentBtn}" Margin="8,0,0,0" Click="BtnBenchmarkPing_Click" />
                                </Grid>
                                <Border Background="{DynamicResource BgSunken}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <TextBlock x:Name="TxtPingResult" Text="Ready to run benchmark." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Low-Latency Packet Dispatch (TCPNoDelay)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtNetworkStatus" Text="Status: Ready." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnApplyNetwork" Content="Apply TCPNoDelay" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="BtnApplyNetwork_Click" />
                                    <Button Content="Restore Defaults" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreNetwork_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 5. BLUESTACKS & MLBB VIEW -->
                    <StackPanel x:Name="ViewBlueStacks" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="BlueStacks &amp; Mobile Legends" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="Virtual machine hypervisor tuning and display lock architecture." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Container Configuration" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtBsConfigStatus" Text="Scanning configuration..." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Optimize Container" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="BtnOptimizeBlueStacks_Click" />
                                    <Button Content="Restore Backup" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreBlueStacks_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Safety Invariants" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock Text="- Key B MOBA Skillpad Protected: com.mobile.legends.cfg preserved" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                <TextBlock Text="- 16:9 Full HD (1920x1080) Locked: Ultra-wide stripped to prevent display distortion" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                <TextBlock Text="- ASUS ROG Phone 7 Ultimate Profile: 120 FPS Whitelist active" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. ACTIVITY LOG VIEW -->
                    <StackPanel x:Name="ViewLogs" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0" />
                        </StackPanel.RenderTransform>

                        <Grid Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Engine Activity Terminal" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Chronological log of system optimization events." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Clear Log" HorizontalAlignment="Right" Style="{StaticResource SecondaryBtn}" Click="BtnClearLog_Click" Padding="10,3" FontSize="11" />
                        </Grid>

                        <Border Background="{DynamicResource BgSunken}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBox x:Name="TxtEventLog" Height="420" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontFamily="Consolas, monospace" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Floating Toast Notification -->
            <Border x:Name="ToastNotification" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="14,10" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.14" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTrans" Y="10" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ToastDot" Width="7" Height="7" Fill="{DynamicResource AccentAction}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" Text="Action Executed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bottom Status Strip -->
            <Border Grid.Row="2" Background="{DynamicResource BgSunken}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtFooterStatus" Text="Zenith Engine Ready. 0 games running. Input Response: 0.500 ms" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="100% Anti-Cheat Safe • Native Windows APIs" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
